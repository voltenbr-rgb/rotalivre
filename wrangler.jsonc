{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rotalivre",
  "main": "custom-worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rotalivre"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rotalivre",
      "database_id": "4bbb422e-7cbe-4a83-b1d7-072177ea418d",
      "migrations_dir": "drizzle"
    }
  ],
  // Manutenção a cada 30 min (limpeza do rádio: mensagens 24 h, fotos 2 h)
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
